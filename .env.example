GROCERY_STATE_DIR=./state
GROCERY_ENCRYPTION_KEY=
GROCERY_HOST=0.0.0.0
GROCERY_PORT=8000
GROCERY_LOG_LEVEL=INFO
GROCERY_DEBUG_HTTP=false
GROCERY_ALLOWED_HOSTS='["grocery-mcp","localhost","127.0.0.1"]'
GROCERY_CHANGE_SET_TTL_SECONDS=900
GROCERY_PRICE_CHANGE_TOLERANCE_PERCENT=5
GROCERY_RETAILER_TIMEOUT_SECONDS=20

# Keep writes false until the authenticated adapter verification is complete.
GROCERY_ENABLE_SIXTY60_WRITES=false
GROCERY_ENABLE_WOOLWORTHS_WRITES=false

# Optional bootstrap values; encrypted persisted locations take precedence.
GROCERY_SIXTY60_LATITUDE=
GROCERY_SIXTY60_LONGITUDE=
GROCERY_SIXTY60_DSL_API_KEY=
GROCERY_SIXTY60_AUTH_API_KEY=
GROCERY_SIXTY60_PROFILE_API_TOKEN=
GROCERY_WOOLWORTHS_PLACE_ID=
GROCERY_WOOLWORTHS_STORE_ID=
GROCERY_WOOLWORTHS_EMAIL=
GROCERY_WOOLWORTHS_PASSWORD=
